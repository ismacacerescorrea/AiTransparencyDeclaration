msgid "plugins.generic.aiTransparencyDeclaration.name"
msgstr "Declaración de Transparencia de IA (AITD)"

msgid "plugins.generic.aiTransparencyDeclaration.description"
msgstr "Incorpora al envío, a los metadatos del artículo y a su página pública una declaración estructurada sobre el uso de inteligencia artificial a partir del modelo AITD v1.1 (Santamarina, Authier y Sohail, 2026)."

msgid "plugins.generic.aiTransparencyDeclaration.settings.description"
msgstr "La declaración se incorpora al formulario de detalles del envío y permanece disponible en los metadatos de la publicación durante el flujo editorial. Cuando está completa, también se presenta en la página pública del artículo."

msgid "plugins.generic.aiTransparencyDeclaration.settings.requireDeclaration"
msgstr "Exigir que la persona responsable del envío declare si se utilizaron herramientas de IA."

msgid "plugins.generic.aiTransparencyDeclaration.form.title"
msgstr "Declaración de transparencia sobre el uso de inteligencia artificial generativa"

msgid "plugins.generic.aiTransparencyDeclaration.form.description"
msgstr "Complete una declaración para el manuscrito."

msgid "plugins.generic.aiTransparencyDeclaration.form.status"
msgstr "Uso de herramientas de IA"

msgid "plugins.generic.aiTransparencyDeclaration.form.status.description"
msgstr "Seleccione la opción que representa el uso de IA durante la preparación de este manuscrito."

msgid "plugins.generic.aiTransparencyDeclaration.form.status.none"
msgstr "En la preparación de este manuscrito no se utilizaron herramientas de inteligencia artificial."

msgid "plugins.generic.aiTransparencyDeclaration.form.status.used"
msgstr "En la preparación de este manuscrito se utilizaron una o más herramientas de inteligencia artificial."

msgid "plugins.generic.aiTransparencyDeclaration.form.selectAll"
msgstr "Seleccione todos los usos aplicables. Una sección sin opciones seleccionadas indica que la IA no se utilizó en ese ámbito."

msgid "plugins.generic.aiTransparencyDeclaration.form.conceptualization"
msgstr "1. Conceptualización e ideación"

msgid "plugins.generic.aiTransparencyDeclaration.form.literatureReview"
msgstr "2. Revisión bibliográfica y síntesis"

msgid "plugins.generic.aiTransparencyDeclaration.form.methodology"
msgstr "3. Metodología y análisis"

msgid "plugins.generic.aiTransparencyDeclaration.form.writing"
msgstr "4. Redacción y composición"

msgid "plugins.generic.aiTransparencyDeclaration.form.interpretation"
msgstr "5. Interpretación y discusión"

msgid "plugins.generic.aiTransparencyDeclaration.use.hypothesis"
msgstr "Generación de hipótesis: la IA ayudó a formular preguntas o hipótesis de investigación."

msgid "plugins.generic.aiTransparencyDeclaration.use.framework"
msgstr "Desarrollo del marco teórico: la IA contribuyó a la elaboración de marcos teóricos o conceptuales."

msgid "plugins.generic.aiTransparencyDeclaration.use.researchGap"
msgstr "Identificación de brechas: la IA ayudó a identificar vacíos en la literatura existente."

msgid "plugins.generic.aiTransparencyDeclaration.use.methodologyBrainstorming"
msgstr "Ideación metodológica: la IA sugirió enfoques metodológicos."

msgid "plugins.generic.aiTransparencyDeclaration.use.projectDesign"
msgstr "Diseño del proyecto: la IA asistió en el diseño general o en la estructura del estudio."

msgid "plugins.generic.aiTransparencyDeclaration.use.literatureSearch"
msgstr "Búsqueda bibliográfica: la IA se utilizó para buscar en bases de datos o identificar artículos pertinentes."

msgid "plugins.generic.aiTransparencyDeclaration.use.paperSummarization"
msgstr "Resumen de artículos: la IA resumió literatura existente."

msgid "plugins.generic.aiTransparencyDeclaration.use.citationManagement"
msgstr "Gestión de citas: la IA asistió en la organización o el formato de las citas."

msgid "plugins.generic.aiTransparencyDeclaration.use.thematicAnalysis"
msgstr "Análisis temático: la IA ayudó a identificar temas o patrones en la literatura."

msgid "plugins.generic.aiTransparencyDeclaration.use.referenceValidation"
msgstr "Validación de referencias: la IA se utilizó para verificar citas o referencias bibliográficas."

msgid "plugins.generic.aiTransparencyDeclaration.use.codeGeneration"
msgstr "Generación de código: la IA escribió código o asistió en la escritura de código o scripts."

msgid "plugins.generic.aiTransparencyDeclaration.use.statisticalAnalysis"
msgstr "Análisis estadístico: la IA realizó pruebas estadísticas o asistió en su ejecución."

msgid "plugins.generic.aiTransparencyDeclaration.use.dataProcessing"
msgstr "Procesamiento de datos: la IA limpió, transformó o procesó datos."

msgid "plugins.generic.aiTransparencyDeclaration.use.visualization"
msgstr "Creación de visualizaciones: la IA creó figuras o gráficos o asistió en su elaboración."

msgid "plugins.generic.aiTransparencyDeclaration.use.methodSelection"
msgstr "Selección de métodos: la IA sugirió métodos o técnicas apropiados."

msgid "plugins.generic.aiTransparencyDeclaration.use.simulationModeling"
msgstr "Simulación o modelado: la IA creó o ejecutó simulaciones o modelos."

msgid "plugins.generic.aiTransparencyDeclaration.use.drafting"
msgstr "Redacción de borradores: la IA redactó partes del manuscrito."

msgid "plugins.generic.aiTransparencyDeclaration.use.paraphrasing"
msgstr "Parafraseo: la IA reformuló contenido escrito por personas."

msgid "plugins.generic.aiTransparencyDeclaration.use.grammarChecking"
msgstr "Revisión lingüística: la IA revisó la gramática, la ortografía o la sintaxis."

msgid "plugins.generic.aiTransparencyDeclaration.use.styleEditing"
msgstr "Edición de estilo: la IA se utilizó para mejorar el estilo o la claridad de la escritura."

msgid "plugins.generic.aiTransparencyDeclaration.use.translation"
msgstr "Traducción: la IA tradujo texto entre idiomas."

msgid "plugins.generic.aiTransparencyDeclaration.use.formatting"
msgstr "Formato: la IA asistió en el formato o en la estructura del documento."

msgid "plugins.generic.aiTransparencyDeclaration.use.resultsInterpretation"
msgstr "Interpretación de resultados: la IA asistió en la interpretación de los hallazgos de la investigación."

msgid "plugins.generic.aiTransparencyDeclaration.use.implications"
msgstr "Formulación de implicaciones: la IA sugirió implicaciones o aplicaciones."

msgid "plugins.generic.aiTransparencyDeclaration.use.limitations"
msgstr "Identificación de limitaciones: la IA ayudó a identificar limitaciones del estudio."

msgid "plugins.generic.aiTransparencyDeclaration.use.futureResearch"
msgstr "Proyección de investigaciones futuras: la IA sugirió futuras líneas de investigación."

msgid "plugins.generic.aiTransparencyDeclaration.use.conclusions"
msgstr "Formulación de conclusiones: la IA asistió en la elaboración de las conclusiones."

msgid "plugins.generic.aiTransparencyDeclaration.form.usesConfirmation"
msgstr "Confirmación de los usos declarados"

msgid "plugins.generic.aiTransparencyDeclaration.form.usesConfirmation.label"
msgstr "Confirmo que he seleccionado todos los usos de IA aplicables a este manuscrito y que las secciones sin opciones seleccionadas representan ámbitos en los que no se utilizó IA."

msgid "plugins.generic.aiTransparencyDeclaration.form.tools"
msgstr "Herramientas de IA utilizadas"

msgid "plugins.generic.aiTransparencyDeclaration.form.tools.description"
msgstr "Indique el nombre de las principales herramientas utilizadas; por ejemplo, ChatGPT, Claude, Gemini o un modelo local."

msgid "plugins.generic.aiTransparencyDeclaration.form.versions"
msgstr "Versiones de los modelos y fechas de acceso"

msgid "plugins.generic.aiTransparencyDeclaration.form.versions.description"
msgstr "Indique las versiones conocidas y el período o las fechas de uso."

msgid "plugins.generic.aiTransparencyDeclaration.form.promptLog"
msgstr "Enlace al registro de instrucciones o al repositorio de código"

msgid "plugins.generic.aiTransparencyDeclaration.form.promptLog.description"
msgstr "Proporcione un DOI o una URL cuando exista un registro disponible. Este dato es opcional."

msgid "plugins.generic.aiTransparencyDeclaration.form.validation"
msgstr "Método de validación humana"

msgid "plugins.generic.aiTransparencyDeclaration.form.validation.description"
msgstr "Seleccione el procedimiento que represente la revisión aplicada a los resultados generados mediante IA."

msgid "plugins.generic.aiTransparencyDeclaration.form.validation.minimal"
msgstr "Básico: todo el contenido generado mediante IA fue revisado y editado por las personas autoras."

msgid "plugins.generic.aiTransparencyDeclaration.form.validation.standard"
msgstr "Estándar: todo el contenido generado mediante IA fue revisado, editado y aprobado por al menos dos coautores."

msgid "plugins.generic.aiTransparencyDeclaration.form.validation.rigorous"
msgstr "Riguroso: el contenido generado mediante IA fue revisado por dos autores, verificado de forma independiente con fuentes primarias cuando correspondía y aprobado por todas las personas autoras."

msgid "plugins.generic.aiTransparencyDeclaration.form.validation.custom"
msgstr "Procedimiento personalizado."

msgid "plugins.generic.aiTransparencyDeclaration.form.validationDetails"
msgstr "Descripción del procedimiento de validación"

msgid "plugins.generic.aiTransparencyDeclaration.form.validationDetails.description"
msgstr "Describa el procedimiento personalizado utilizado para revisar y verificar los resultados generados mediante IA."

msgid "plugins.generic.aiTransparencyDeclaration.form.responsibility"
msgstr "Supervisión humana y responsabilidad"

msgid "plugins.generic.aiTransparencyDeclaration.form.responsibility.description"
msgstr "Esta confirmación forma parte de la declaración correspondiente al artículo completo."

msgid "plugins.generic.aiTransparencyDeclaration.form.responsibility.label"
msgstr "Las personas autoras asumen plena responsabilidad por el contenido del manuscrito. Todo texto, código y sugerencia generados mediante IA fueron revisados críticamente, verificados y editados; los argumentos, las conclusiones y la integridad del trabajo pertenecen a sus autores."

msgid "plugins.generic.aiTransparencyDeclaration.form.attribution.title"
msgstr "Modelo y atribución"

msgid "plugins.generic.aiTransparencyDeclaration.form.attribution.description"
msgstr "Basado en el Modelo de Declaración de Transparencia de IA (AITD) v1.1 de Sergio Santamarina, Carlos Authier y Aamir Sohail (2026). <a href=\"https://doi.org/10.5281/zenodo.18601557\" target=\"_blank\" rel=\"noopener noreferrer\">https://doi.org/10.5281/zenodo.18601557</a>"

msgid "plugins.generic.aiTransparencyDeclaration.public.toggle"
msgstr "Mostrar declaración"

msgid "plugins.generic.aiTransparencyDeclaration.public.status.none"
msgstr "Sin uso de IA declarado"

msgid "plugins.generic.aiTransparencyDeclaration.public.status.used"
msgstr "Uso de IA declarado"

msgid "plugins.generic.aiTransparencyDeclaration.public.introduction"
msgstr "De acuerdo con el marco de la Declaración de Transparencia de IA (AITD) v1.1, las personas autoras declaran el siguiente uso de inteligencia artificial generativa en esta investigación."

msgid "plugins.generic.aiTransparencyDeclaration.public.noAi"
msgstr "Las personas autoras declaran que no utilizaron herramientas de inteligencia artificial en la preparación de este manuscrito."

msgid "plugins.generic.aiTransparencyDeclaration.public.declaredUses"
msgstr "Usos declarados"

msgid "plugins.generic.aiTransparencyDeclaration.public.technicalDetails"
msgstr "Información técnica"

msgid "plugins.generic.aiTransparencyDeclaration.public.tools"
msgstr "Herramientas de IA"

msgid "plugins.generic.aiTransparencyDeclaration.public.versions"
msgstr "Versiones y fechas de acceso"

msgid "plugins.generic.aiTransparencyDeclaration.public.promptLog"
msgstr "Registro de instrucciones o código"

msgid "plugins.generic.aiTransparencyDeclaration.public.humanOversight"
msgstr "Supervisión humana y verificación"

msgid "plugins.generic.aiTransparencyDeclaration.public.validation"
msgstr "Método de validación"

msgid "plugins.generic.aiTransparencyDeclaration.public.responsibility"
msgstr "Responsabilidad de las personas autoras"

msgid "plugins.generic.aiTransparencyDeclaration.public.attribution"
msgstr "AITD v1.1 (Santamarina, Authier y Sohail, 2026)"

