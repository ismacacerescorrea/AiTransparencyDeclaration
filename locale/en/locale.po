msgid ""
msgstr ""
"Project-Id-Version: AI Transparency Declaration for OPS 0.3.0.1\n"
"PO-Revision-Date: 2026-07-24 00:00-0400\n"
"Last-Translator: AITD OPS adaptation\n"
"Language-Team: English\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: en\n"

msgid "plugins.generic.aiTransparencyDeclaration.name"
msgstr "AI Transparency Declaration (AITD)"

msgid "plugins.generic.aiTransparencyDeclaration.description"
msgstr "Adds a structured declaration on the use of artificial intelligence to the submission workflow, preprint metadata, and public preprint page, based on the AITD Model v1.1 (Santamarina, Authier, and Sohail, 2026)."

msgid "plugins.generic.aiTransparencyDeclaration.settings.description"
msgstr "The declaration is added to the submission Details form and remains available in the preprint metadata throughout the editorial workflow. When complete, it is also presented on the public preprint page."

msgid "plugins.generic.aiTransparencyDeclaration.settings.requireDeclaration"
msgstr "Require the submitting author to declare whether AI tools were used."

msgid "plugins.generic.aiTransparencyDeclaration.form.title"
msgstr "Transparency declaration on the use of generative artificial intelligence"

msgid "plugins.generic.aiTransparencyDeclaration.form.description"
msgstr "Complete one declaration for the preprint."

msgid "plugins.generic.aiTransparencyDeclaration.form.status"
msgstr "Use of AI tools"

msgid "plugins.generic.aiTransparencyDeclaration.form.status.description"
msgstr "Select the statement that reflects the use of AI during the preparation of this preprint."

msgid "plugins.generic.aiTransparencyDeclaration.form.status.none"
msgstr "No artificial intelligence tools were used in the preparation of this preprint."

msgid "plugins.generic.aiTransparencyDeclaration.form.status.used"
msgstr "One or more artificial intelligence tools were used in the preparation of this preprint."

msgid "plugins.generic.aiTransparencyDeclaration.form.selectAll"
msgstr "Select all applicable uses. A section with no selected options indicates that AI was not used in that area."

msgid "plugins.generic.aiTransparencyDeclaration.form.conceptualization"
msgstr "1. Conceptualization and ideation"

msgid "plugins.generic.aiTransparencyDeclaration.form.literatureReview"
msgstr "2. Literature review and synthesis"

msgid "plugins.generic.aiTransparencyDeclaration.form.methodology"
msgstr "3. Methodology and analysis"

msgid "plugins.generic.aiTransparencyDeclaration.form.writing"
msgstr "4. Writing and composition"

msgid "plugins.generic.aiTransparencyDeclaration.form.interpretation"
msgstr "5. Interpretation and discussion"

msgid "plugins.generic.aiTransparencyDeclaration.use.hypothesis"
msgstr "Hypothesis generation: AI assisted in formulating research questions or hypotheses."

msgid "plugins.generic.aiTransparencyDeclaration.use.framework"
msgstr "Theoretical framework development: AI contributed to theoretical or conceptual frameworks."

msgid "plugins.generic.aiTransparencyDeclaration.use.researchGap"
msgstr "Research gap identification: AI helped identify gaps in the existing literature."

msgid "plugins.generic.aiTransparencyDeclaration.use.methodologyBrainstorming"
msgstr "Methodological ideation: AI suggested methodological approaches."

msgid "plugins.generic.aiTransparencyDeclaration.use.projectDesign"
msgstr "Project design: AI assisted with the overall study design or structure."

msgid "plugins.generic.aiTransparencyDeclaration.use.literatureSearch"
msgstr "Literature search: AI was used to search databases or identify relevant publications."

msgid "plugins.generic.aiTransparencyDeclaration.use.paperSummarization"
msgstr "Publication summarization: AI summarized existing literature."

msgid "plugins.generic.aiTransparencyDeclaration.use.citationManagement"
msgstr "Citation management: AI assisted with citation organization or formatting."

msgid "plugins.generic.aiTransparencyDeclaration.use.thematicAnalysis"
msgstr "Thematic analysis: AI helped identify themes or patterns in the literature."

msgid "plugins.generic.aiTransparencyDeclaration.use.referenceValidation"
msgstr "Reference validation: AI was used to verify citations or bibliographic references."

msgid "plugins.generic.aiTransparencyDeclaration.use.codeGeneration"
msgstr "Code generation: AI wrote or assisted in writing code or scripts."

msgid "plugins.generic.aiTransparencyDeclaration.use.statisticalAnalysis"
msgstr "Statistical analysis: AI performed or assisted with statistical tests."

msgid "plugins.generic.aiTransparencyDeclaration.use.dataProcessing"
msgstr "Data processing: AI cleaned, transformed, or processed data."

msgid "plugins.generic.aiTransparencyDeclaration.use.visualization"
msgstr "Visualization creation: AI created or assisted in creating figures or charts."

msgid "plugins.generic.aiTransparencyDeclaration.use.methodSelection"
msgstr "Method selection: AI suggested appropriate methods or techniques."

msgid "plugins.generic.aiTransparencyDeclaration.use.simulationModeling"
msgstr "Simulation or modeling: AI created or ran simulations or models."

msgid "plugins.generic.aiTransparencyDeclaration.use.drafting"
msgstr "Drafting: AI drafted portions of the preprint."

msgid "plugins.generic.aiTransparencyDeclaration.use.paraphrasing"
msgstr "Paraphrasing: AI rephrased human-written content."

msgid "plugins.generic.aiTransparencyDeclaration.use.grammarChecking"
msgstr "Language review: AI checked grammar, spelling, or syntax."

msgid "plugins.generic.aiTransparencyDeclaration.use.styleEditing"
msgstr "Style editing: AI was used to improve writing style or clarity."

msgid "plugins.generic.aiTransparencyDeclaration.use.translation"
msgstr "Translation: AI translated text between languages."

msgid "plugins.generic.aiTransparencyDeclaration.use.formatting"
msgstr "Formatting: AI assisted with document formatting or structure."

msgid "plugins.generic.aiTransparencyDeclaration.use.resultsInterpretation"
msgstr "Results interpretation: AI assisted in interpreting research findings."

msgid "plugins.generic.aiTransparencyDeclaration.use.implications"
msgstr "Development of implications: AI suggested implications or applications."

msgid "plugins.generic.aiTransparencyDeclaration.use.limitations"
msgstr "Identification of limitations: AI helped identify limitations of the study."

msgid "plugins.generic.aiTransparencyDeclaration.use.futureResearch"
msgstr "Future research: AI suggested directions for future research."

msgid "plugins.generic.aiTransparencyDeclaration.use.conclusions"
msgstr "Development of conclusions: AI assisted in formulating the conclusions."

msgid "plugins.generic.aiTransparencyDeclaration.form.usesConfirmation"
msgstr "Confirmation of declared uses"

msgid "plugins.generic.aiTransparencyDeclaration.form.usesConfirmation.label"
msgstr "I confirm that I have selected all AI uses applicable to this preprint and that sections with no selected options represent areas in which AI was not used."

msgid "plugins.generic.aiTransparencyDeclaration.form.tools"
msgstr "AI tools used"

msgid "plugins.generic.aiTransparencyDeclaration.form.tools.description"
msgstr "List the primary tools used, such as ChatGPT, Claude, Gemini, or a local model."

msgid "plugins.generic.aiTransparencyDeclaration.form.versions"
msgstr "Model versions and access dates"

msgid "plugins.generic.aiTransparencyDeclaration.form.versions.description"
msgstr "Provide known model versions and the dates or period of use."

msgid "plugins.generic.aiTransparencyDeclaration.form.promptLog"
msgstr "Link to a prompt log or code repository"

msgid "plugins.generic.aiTransparencyDeclaration.form.promptLog.description"
msgstr "Provide a complete URL, including a DOI URL, when a record is available. This field is optional."

msgid "plugins.generic.aiTransparencyDeclaration.form.validation"
msgstr "Human validation method"

msgid "plugins.generic.aiTransparencyDeclaration.form.validation.description"
msgstr "Select the procedure that best represents the review applied to AI-generated outputs."

msgid "plugins.generic.aiTransparencyDeclaration.form.validation.minimal"
msgstr "Basic: all AI-generated content was reviewed and edited by the authors."

msgid "plugins.generic.aiTransparencyDeclaration.form.validation.standard"
msgstr "Standard: all AI-generated content was reviewed, edited, and approved by at least two co-authors."

msgid "plugins.generic.aiTransparencyDeclaration.form.validation.rigorous"
msgstr "Rigorous: AI-generated content was reviewed by two authors, independently verified against primary sources where applicable, and approved by all authors."

msgid "plugins.generic.aiTransparencyDeclaration.form.validation.custom"
msgstr "Custom procedure."

msgid "plugins.generic.aiTransparencyDeclaration.form.validationDetails"
msgstr "Description of the validation procedure"

msgid "plugins.generic.aiTransparencyDeclaration.form.validationDetails.description"
msgstr "Describe the custom procedure used to review and verify AI-generated outputs."

msgid "plugins.generic.aiTransparencyDeclaration.form.responsibility"
msgstr "Human oversight and responsibility"

msgid "plugins.generic.aiTransparencyDeclaration.form.responsibility.description"
msgstr "This confirmation forms part of the declaration for the preprint as a whole."

msgid "plugins.generic.aiTransparencyDeclaration.form.responsibility.label"
msgstr "The authors accept full responsibility for the preprint's content. All AI-generated text, code, and suggestions were critically reviewed, verified, and edited; the arguments, conclusions, and integrity of the work remain the authors' own."

msgid "plugins.generic.aiTransparencyDeclaration.form.attribution.title"
msgstr "Model and attribution"

msgid "plugins.generic.aiTransparencyDeclaration.form.attribution.description"
msgstr "Based on the AI Transparency Declaration (AITD) Model v1.1 by Sergio Santamarina, Carlos Authier, and Aamir Sohail (2026). <a href=\"https://doi.org/10.5281/zenodo.18601557\" target=\"_blank\" rel=\"noopener noreferrer\">https://doi.org/10.5281/zenodo.18601557</a>"

msgid "plugins.generic.aiTransparencyDeclaration.public.toggle"
msgstr "Show declaration"

msgid "plugins.generic.aiTransparencyDeclaration.public.status.none"
msgstr "No AI use declared"

msgid "plugins.generic.aiTransparencyDeclaration.public.status.used"
msgstr "AI use declared"

msgid "plugins.generic.aiTransparencyDeclaration.public.introduction"
msgstr "In accordance with the AI Transparency Declaration (AITD) framework v1.1, the authors disclose the following use of generative artificial intelligence in this research."

msgid "plugins.generic.aiTransparencyDeclaration.public.noAi"
msgstr "The authors declare that no artificial intelligence tools were used in the preparation of this preprint."

msgid "plugins.generic.aiTransparencyDeclaration.public.declaredUses"
msgstr "Declared uses"

msgid "plugins.generic.aiTransparencyDeclaration.public.technicalDetails"
msgstr "Technical information"

msgid "plugins.generic.aiTransparencyDeclaration.public.tools"
msgstr "AI tools"

msgid "plugins.generic.aiTransparencyDeclaration.public.versions"
msgstr "Versions and access dates"

msgid "plugins.generic.aiTransparencyDeclaration.public.promptLog"
msgstr "Prompt log or code repository"

msgid "plugins.generic.aiTransparencyDeclaration.public.humanOversight"
msgstr "Human oversight and verification"

msgid "plugins.generic.aiTransparencyDeclaration.public.validation"
msgstr "Validation method"

msgid "plugins.generic.aiTransparencyDeclaration.public.responsibility"
msgstr "Author responsibility"

msgid "plugins.generic.aiTransparencyDeclaration.public.attribution"
msgstr "AITD v1.1 (Santamarina, Authier, and Sohail, 2026)"
